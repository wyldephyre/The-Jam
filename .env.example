# Optional shared site password. When set, viewers enter it before account
# login. Leave it empty to send people straight to account login.
# Account login is always required to request a song or send a message.
VIEWER_PASSWORD=your-viewer-password
ADMIN_PASSWORD=your-admin-password
# Mark the viewer session cookie Secure. Leave empty to turn Secure on only
# when the request is HTTPS or X-Forwarded-Proto is https. Set 1 on the public
# Zo site. Set 0 for plain http://localhost.
COOKIE_SECURE=
REGULAR_THRESHOLD_MINUTES=18000
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REFRESH_TOKEN=your-spotify-refresh-token
PORT=3000

# Social Stream Ninja live chat. Leave SSN_SESSION_ID empty to run without it.
# Copy the session id from the SSN dock URL (?session=). It is a secret.
# Never commit a real session id or password.
# When SSN_SESSION_ID is set, approving a viewer message (not a song) forwards
# it to SSN for dock text-to-speech. See docs/DEPLOY-ZO.md for the TTS toggles.
SSN_SESSION_ID=
SSN_PASSWORD=
# Hosted relay. For SSN's local websocket on the same machine, use ws://127.0.0.1:3003
SSN_SERVER_URL=wss://io.socialstream.ninja
# Comma-separated source types. Use * to allow every platform SSN sends.
SSN_PLATFORMS=twitch,youtube,rumble,x,twitter
# Set to 1 to drop messages SSN marks as bots.
SSN_HIDE_BOTS=
